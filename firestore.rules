rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Každý prihlásený hráč si číta a zapisuje LEN svoj vlastný postup.
    // Čítať smú všetci prihlásení hráči (kvôli rebríčku).
    match /progress/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
